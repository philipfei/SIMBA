# Tracked DDS environment for the SIMBA hosts.
export ROS_DOMAIN_ID=0
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

if [ "$(hostname -s)" = "create3-pi" ]; then
    export CYCLONEDDS_URI='<CycloneDDS><Domain Id="any"><General><Interfaces><NetworkInterface name="eth0" priority="10" multicast="default"/><NetworkInterface name="wlan0" priority="20" multicast="default"/></Interfaces></General></Domain></CycloneDDS>'
else
    export CYCLONEDDS_URI='<CycloneDDS><Domain Id="any"><General><Interfaces><NetworkInterface name="enx00e17c6840b1" multicast="default"/></Interfaces></General></Domain></CycloneDDS>'
fi
